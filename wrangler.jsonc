{
  "name": "score-keeper",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Create your own with `npx wrangler d1 create score-keeper` and paste the id it prints
  "d1_databases": [
    { "binding": "DB", "database_name": "score-keeper", "database_id": "9f69fa51-824b-469e-aa23-d19e332ada68" }
  ],
  // One Durable Object per shared board; SQLite-backed so it runs on the free plan
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
